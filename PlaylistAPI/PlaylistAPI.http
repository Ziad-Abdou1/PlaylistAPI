@RootURL = http://localhost:5016

# data from the seeded database
@UserId = 11111111-1111-1111-1111-111111111111
@PlaylistId = 22222222-2222-2222-2222-222222222222
@SeededSongId = 33333333-3333-3333-3333-333333333333

# fetch all playlists for a user
GET {{RootURL}}/api/playlist/user/{{UserId}}

###
# create new playlist for a user
POST {{RootURL}}/api/playlist/user/{{UserId}}
Content-Type: application/json

{
  "name": "My Weekend Vibes"
}


###
# add a song to the playlist
POST {{RootURL}}/api/playlist/{{PlaylistId}}/songs
Content-Type: application/json

{
  "title": "Stairway to Heaven"
}

###
# update the name of the playlist
PUT {{RootURL}}/api/playlist/{{PlaylistId}}
Content-Type: application/json

{
  "name": "Updated Coding Mix"
}

###
#  remoce a song from the playlist
DELETE {{RootURL}}/api/playlist/{{PlaylistId}}/songs/{{SeededSongId}}


###
#  delete a playlist for a user
DELETE {{RootURL}}/api/playlist/{{PlaylistId}}/user/{{UserId}}